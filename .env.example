# Copy to .env for local development; never commit real credentials.
# Lookup order: process GEMINI_API_KEY, project .env, Windows Credential Manager.
# Literal values only; variable expansion and commands are never evaluated.
GEMINI_API_KEY=

# Live voice model (independent of the legacy text model).
GEMINI_LIVE_MODEL=gemini-3.8-live
# Optional numeric device IDs from --list-audio-devices; blank uses Windows default.
VOICE_INPUT_DEVICE=
VOICE_OUTPUT_DEVICE=
